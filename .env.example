# 复制为 .env.local；仅在本机服务端填写密钥，切勿提交或放进 NEXT_PUBLIC_ 变量。
# 未填写密钥时仍可手动录入；真实识别、灵感分析和推荐会调用 OpenRouter，可能产生费用。
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen3.8-max-0902
# 服务端请求超时，单位毫秒；当前 Qwen 识图和灵感分析实测可能超过 60 秒，统一使用 90 秒。
# 可设置为 1 至 180000 的整数；无效值回退到 90000。此值不控制本机 BiRefNet 推理。
AI_TIMEOUT_MS=90000
NEXT_TELEMETRY_DISABLED=1
