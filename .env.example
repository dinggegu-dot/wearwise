# 复制为 .env.local 仅在需要自定义本地配置时使用。普通示例、手动录入无需配置。
# 模型密钥仅存服务端；启用识别前确认服务、费用和测试图片权限。
AI_ENABLE=0
DASHSCOPE_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_ALLOWED_ORIGINS=https://dashscope.aliyuncs.com
QWEN_MODEL=
AI_MAX_CALLS_PER_PROCESS=0
AI_TIMEOUT_MS=30000
NEXT_TELEMETRY_DISABLED=1
