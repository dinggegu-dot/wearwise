# 复制为 .env.local；仅在本机服务端填写密钥，切勿提交或放进 NEXT_PUBLIC_ 变量。
# 真实识别、灵感分析、参考图分析、推荐和在线白底处理会调用 OpenRouter，可能产生费用。
OPENROUTER_API_KEY=
AI_MODEL=qwen/qwen3.8-max-0902
# 服务端请求超时，单位毫秒；当前 Qwen 识图和灵感分析实测可能超过 60 秒，统一使用 90 秒。
# 可设置为 1 至 180000 的整数；无效值回退到 90000。
AI_TIMEOUT_MS=90000
NEXT_TELEMETRY_DISABLED=1
# 白底图片编辑选用 Seedream 5.0 Flash；以后可只改此模型 ID 切换其他支持参考图编辑的模型。
# 与识别模型独立；需要 OpenRouter 账户余额，调用会产生费用。
OPENROUTER_BACKGROUND_MODEL=bytedance-seed/seedream-5-0-flash
# 图片编辑超时，单位毫秒；可设 1–180000，无效值回退到 120000。
AI_BACKGROUND_TIMEOUT_MS=120000
