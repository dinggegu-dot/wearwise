{
  "name": "wearwise",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build:pages": "node scripts/build-pages.mjs",
    "serve:pages": "node scripts/serve-pages.mjs",
    "test:e2e:pages": "playwright test --config=playwright.pages.config.ts",
    "test:e2e:live": "playwright test --config=playwright.live.config.ts",
    "test:e2e:dev": "playwright test --config=playwright.dev.config.ts",
    "preview": "npm run build && npm run start"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "dexie": "4.4.7",
    "zod": "4.6.7",
    "lucide-react": "1.69.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "@types/node": "22.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.4",
    "@tailwindcss/postcss": "4.3.4",
    "postcss": "8.5.32",
    "vitest": "4.1.12",
    "vite": "7.3.7",
    "fake-indexeddb": "6.2.7",
    "@playwright/test": "1.64.1"
  }
}
